# Copy to .env.local for local dev, and add the same values in Vercel -> Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase -> Project Settings -> API Keys -> secret (sb_secret_...) or legacy service_role.
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# https://resend.com/api-keys
RESEND_API_KEY=
# Until you verify a domain in Resend, keep the shared sender. It can only deliver to your own Resend account email.
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# Optional: where candidate replies go
# RESEND_REPLY_TO=arjun@yourdomain.com

# While testing, every email goes here instead of to the candidate. Remove it to email candidates for real.
EMAIL_TEST_RECIPIENT=you@example.com

# Optional: booking link included in interview invites (otherwise the email asks for 2-3 times)
# INTERVIEW_BOOKING_URL=https://cal.com/arjun/45min

# Arjun's own inbox: gets a calendar copy of every booked interview (the test inbox is used while EMAIL_TEST_RECIPIENT is set)
FOUNDER_EMAIL=arjun@example.com

# Optional: public URL used in calendar and email links (defaults to the request host)
# APP_URL=https://kargo-hire.vercel.app

# Password for the dashboard. Set this on Vercel: candidate data is private.
DASHBOARD_PASSWORD=
